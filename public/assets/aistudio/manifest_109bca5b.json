{
  "manifest_version": 3,
  "name": "ASSEDGE",
  "version": "1.4.8",
  "minimum_chrome_version": "116",
  "description": "ASSEDGE for Refumo: search CRM assets and send instructions to Sam AI.",
  "permissions": [
    "sidePanel",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://nvidia-vera-rubin.tailc9ae59.ts.net/*"
  ],
  "action": {
    "default_title": "Open ASSEDGE"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "oauth2": {
    "client_id": "843671395931-0lkde0id93v4p8f87tcoaq4u97i4vl4t.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets.readonly"
    ]
  },
  "key": ""
}
